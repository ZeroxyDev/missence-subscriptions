# Shopify app client secret used to verify X-Shopify-Hmac-SHA256.
# SHOPIFY_WEBHOOK_KEY is also accepted for backwards compatibility.
SHOPIFY_WEBHOOK_SECRET=

# Bearer token used for outbound Bigblue Store API requests.
BIGBLUE_API_KEY=

# Only needed when this application starts receiving Bigblue webhooks.
BIGBLUE_WEBHOOK_KEY=

