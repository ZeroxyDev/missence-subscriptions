# Shopify app client secret used to verify X-Shopify-Hmac-SHA256.
# SHOPIFY_WEBHOOK_KEY is also accepted for backwards compatibility.
SHOPIFY_WEBHOOK_SECRET=

# Storefront API credentials used by the live health check.
SHOPIFY_STORE_DOMAIN=missence.com
# Public Storefront token. Not currently used by the server integration.
SHOPIFY_PUBLIC_ACCESS_TOKEN=
# Private Storefront token. Never expose this value to the browser.
SHOPIFY_PRIVATE_ACCESS_TOKEN=

# Bearer token used for outbound Bigblue Store API requests.
BIGBLUE_API_KEY=

# Only needed when this application starts receiving Bigblue webhooks.
BIGBLUE_WEBHOOK_KEY=
