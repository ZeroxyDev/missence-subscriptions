# Shopify app client secret used to verify X-Shopify-Hmac-SHA256.
# SHOPIFY_WEBHOOK_KEY is also accepted for backwards compatibility.
SHOPIFY_WEBHOOK_SECRET=

# Storefront API credentials used by the live health check.
SHOPIFY_STORE_DOMAIN=missence.com
# Public Storefront token. Not currently used by the server integration.
SHOPIFY_PUBLIC_ACCESS_TOKEN=
# Private Storefront token. Never expose this value to the browser.
SHOPIFY_PRIVATE_ACCESS_TOKEN=

# Admin API token with read_orders. Existing SHOPIFY_ACCESS_TOKEN is supported.
SHOPIFY_ACCESS_TOKEN=
# If SHOPIFY_STORE_DOMAIN is a public domain, set the permanent Admin hostname here.
# When SHOPIFY_STORE_DOMAIN already is *.myshopify.com, this can stay unset.
SHOPIFY_ADMIN_STORE_DOMAIN=
# Long random bearer secret shared only with the external scheduler.
RECONCILIATION_CRON_SECRET=

# Bearer token used for outbound Bigblue Store API requests.
BIGBLUE_API_KEY=

# Secret used to derive a scoped token for the Bigblue webhook target URL.
# Configure the same value on Vercel. Never put the raw key in the URL.
BIGBLUE_WEBHOOK_KEY=
